  <app-header-home></app-header-home>

  <main class="main-inicio">
    <div id="viewInicio" class="landing">
      <section class="hero" id="inicio">
        <div class="hero-grid">
          <div class="hero-content">
            <div class="hero-brand">
              <span class="hero-tag">Plataforma Educacional</span>
            </div>
            <h1>Aprenda TI em <span class="hero-highlight">Libras</span></h1>
            <p>Vídeos de sinais, quizzes interativos e sinalário com várias categorias. Tecnologia acessível, do jeito que você precisa.</p>
            <div class="hero-actions">
              <button class="btn btn-light" id="openLogin"><i class="fa-solid fa-right-to-bracket"></i> Entrar</button>
              <button class="btn btn-ghost-light" id="openRegister"><i class="fa-solid fa-user-plus"></i> Criar conta gratuita</button>
            </div>
          </div>

          <div class="hero-media">
            <div class="video-card">
              <div class="video-card-top">
                <span class="video-card-title">Conheça a plataforma</span>
              </div>
              <div class="video-card-frame">
                <video
                  id="videoApresentacao"
                  src="/videos/apresentacao.mp4"
                  title="Vídeo de apresentação do T.I. Libras"
                  preload="metadata"
                  playsinline
                  controls>
                </video>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="presentation" id="sobre">
        <div class="pres-card pres-feature">
          <div class="pres-media">
            <i class="fa-solid fa-users"></i>
          </div>
          <div class="pres-body">
            <h2>Quem somos?</h2>
            <p>Somos um grupo de <strong>projeto de extensão e pesquisa do IFRN Campus Santa Cruz</strong>, unindo Tecnologia da Informação e Libras para ensinar de forma acessível e inclusiva.</p>
            <p>Nosso objetivo é democratizar o acesso ao conhecimento, oferecendo um site acessível e prático, focado em termos e categorias de Tecnologia da Informação (TI) em Libras.</p>
            <p>A plataforma foi desenvolvida para ser um espaço interativo, onde os usuários podem aprender e praticar esses conceitos de forma totalmente gratuita.</p>
          </div>
        </div>
      </section>
      <section class="presentation" id="recursos">
      <div class="perks">
      <div class="perk-card">
      <span class="perk-icon"><i class="fa-solid fa-hand-holding-heart"></i></span>
      <div>
      <strong>100% Gratuito</strong>
      <p>Ensino acessível e sem custo</p>
      </div>
      </div>
          <div class="perk-card">
            <span class="perk-icon"><i class="fa-solid fa-universal-access"></i></span>
            <div>
              <strong>Acessível</strong>
              <p>Feito para todos os públicos</p>
            </div>
          </div>
          <div class="perk-card">
            <span class="perk-icon"><i class="fa-solid fa-chart-line"></i></span>
            <div>
              <strong>Progresso Sincronizado</strong>
              <p>Salve favoritos e acompanhe seu avanço na conta.</p>
            </div>
          </div>
        </div>
      </section>
      <section class="presentation" id="categorias">
        <div class="cat-showcase">
          <div class="cat-showcase-head">
            <h2>Categorias disponíveis</h2>
          </div>
          <div class="cat-showcase-grid">
            <div class="cat-tile cat-redes">
              <span class="cat-tile-icon"><i class="fa-solid fa-tower-broadcast"></i></span>
              <strong>Redes</strong>
              <small>Internet e Conexões</small>
            </div>
            <div class="cat-tile cat-programacao">
              <span class="cat-tile-icon"><i class="fa-solid fa-laptop-code"></i></span>
              <strong>Programação</strong>
              <small>Código e Algoritmos</small>
            </div>
            <div class="cat-tile cat-eletricidade">
              <span class="cat-tile-icon"><i class="fa-solid fa-plug"></i></span>
              <strong>Eletricidade</strong>
              <small>Circuitos Elétricos</small>
            </div>
            <div class="cat-tile cat-hardware">
              <span class="cat-tile-icon"><i class="fa-solid fa-desktop"></i></span>
              <strong>Hardware</strong>
              <small>Peças e Componentes</small>
            </div>
            <div class="cat-tile cat-software">
              <span class="cat-tile-icon"><i class="fa-solid fa-compact-disc"></i></span>
              <strong>Software</strong>
              <small>Sistemas e Apps</small>
            </div>
          </div>
        </div>
      </section>
    </div>
    {{> login-view}}

    {{> register-view}}
  </main>

  <app-footer></app-footer>
