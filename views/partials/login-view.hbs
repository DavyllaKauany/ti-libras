    <section class="auth-inline" id="viewLogin" hidden>
      <div class="auth-page">
        <div class="auth-form-side">
          <div class="auth-form-wrap">
            <div class="auth-card">
              <div class="auth-card-inner">
                <div class="auth-form-main">
                  <button type="button" class="btn-back-inline" data-voltar><i class="fa-solid fa-arrow-left"></i> Voltar</button>
                  <h2 class="auth-heading">Entrar</h2>
                  <form id="loginForm" class="form">
                    <div class="field">
                      <label for="loginEmail"><i class="fa-regular fa-envelope"></i> E-mail</label>
                      <input id="loginEmail" type="email" required placeholder="seu@exemplo.com">
                    </div>
                    <div class="field">
                      <label for="loginPass"><i class="fa-solid fa-lock"></i> Senha</label>
                      <span class="pass-field">
                        <input id="loginPass" type="password" minlength="6" required placeholder="••••••••">
                        <button type="button" class="toggle-pass" data-toggle-pass="loginPass" aria-label="Mostrar senha" aria-pressed="false"><i class="fa-solid fa-eye"></i></button>
                      </span>
                    </div>
                    <div class="form-check">
                      <input id="loginRemember" type="checkbox">
                      <label for="loginRemember">Lembrar de mim</label>
                    </div>
                    <div class="form-actions">
                      <button type="submit" class="btn btn-primary btn-full">Entrar</button>
                    </div>
                    <div id="loginFeedback" class="feedback"></div>
                  </form>
                </div>
                <div class="auth-form-foot">
                  <p class="auth-switch">Novo por aqui? <button type="button" id="switchToRegister">Criar conta</button></p>
                  <div class="small-info">
                    <p>Veja os <a href="termos.html" target="_blank" rel="noopener">Termos de Uso e a Política de Privacidade</a>.</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
        <aside class="auth-visual">
          <div class="visual-inner">
            <h1 class="visual-title">Aprenda termos de TI em Libras de forma prática e Interativa</h1>
            <p class="visual-sub">Aprenda sinais com exemplos reais, pratique passo a passo e acompanhe seu progresso. Salve favoritos e avance no seu ritmo, com tudo sincronizado na sua conta.</p>
          </div>
        </aside>
      </div>
    </section>
